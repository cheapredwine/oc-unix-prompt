{
  "name": "oc-unix-prompt",
  "version": "0.1.0",
  "description": "OpenCode TUI plugin: UNIX-style prompt line (date/time, cwd, git) above the composer",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=dist/index.js --format=esm --platform=node --external:@opencode/plugin && esbuild src/tui.tsx --bundle --outfile=dist/tui.js --format=esm --jsx=automatic --jsx-import-source=@opentui/solid --platform=node --external:@opencode/plugin --external:@opentui/core --external:@opentui/solid --external:solid-js",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm build && pnpm typecheck"
  },
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "devDependencies": {
    "@opencode/theme": "^2.2.5",
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "@types/node": "^26.6.6",
    "esbuild": "latest",
    "solid-js": ">=1.9.0",
    "typescript": "latest"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}